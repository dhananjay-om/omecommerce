# Reverse proxy + automatic HTTPS (Let's Encrypt) for a SINGLE public domain
# serving both Next.js apps by path: the storefront at the domain root, the
# admin app at /admin (matching apps/admin/next.config.ts's `basePath:
# '/admin'`). The backend API is intentionally NOT exposed here — both apps
# only ever call it server-side over the internal Docker network (see
# DEPLOYMENT.md "Why the API isn't public"). Uncomment the api_domain block
# below only if you later need direct external API access (mobile app,
# inbound webhooks, etc.).
#
# {$DOMAIN} comes from docker-compose.prod.yml's environment block, sourced
# from .env.production.
#
# `handle` (not `handle_path`) forwards the request path UNCHANGED to the
# upstream — required here because admin's basePath means the Next server
# itself expects to see the /admin prefix on incoming requests; stripping it
# would 404 every admin route.

{$DOMAIN} {
	handle /admin* {
		reverse_proxy admin:3000
	}
	handle {
		reverse_proxy storefront:3001
	}
	encode zstd gzip
}

# {$API_DOMAIN} {
# 	reverse_proxy api:3000
# 	encode zstd gzip
# }
