# Copy to .env.production and fill in real values before deploying (see
# DEPLOYMENT.md). Consumed by `docker compose -f docker-compose.prod.yml`.
# NEVER commit the filled-in .env.production — it holds real secrets.

# --- Postgres (container-internal; not published to the host) ---
POSTGRES_USER=ome
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_-base64_32
POSTGRES_DB=omecommerce

# --- Redis (container-internal) ---
REDIS_PASSWORD=CHANGE_ME_use_openssl_rand_-base64_32

# --- MinIO / S3-compatible object storage (container-internal) ---
S3_ACCESS_KEY=ome
S3_SECRET_KEY=CHANGE_ME_use_openssl_rand_-base64_32
S3_BUCKET=ome-media

# --- Backend auth secrets — each must be a distinct random value ---
JWT_SECRET=CHANGE_ME_use_openssl_rand_-base64_48
GIFT_CARD_HMAC_SECRET=CHANGE_ME_use_openssl_rand_-base64_48

LOG_LEVEL=info

# --- Storefront: which website/store view this deployment serves ---
# Matches the seeded reference data (see prisma/seed.ts) — change only if
# you've seeded a different website/store-view code.
WEBSITE_CODE=us_retail
STORE_VIEW_ID=1

# --- Public domain (Caddy reads this to request a TLS cert) ---
# Single domain for both apps: storefront at the root, admin at /admin
# (see deploy/Caddyfile + apps/admin/next.config.ts's basePath). Only ONE
# DNS A record is needed — no admin./shop. subdomains.
DOMAIN=www.example.com
