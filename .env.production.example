# Copy to .env.production and fill in real values before deploying (see
# DEPLOYMENT.md). Consumed by `docker compose -f docker-compose.prod.yml`.
# NEVER commit the filled-in .env.production — it holds real secrets.

# --- Postgres (container-internal; not published to the host) ---
POSTGRES_USER=ome
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_-base64_32
POSTGRES_DB=omecommerce

# --- Redis (container-internal) ---
REDIS_PASSWORD=CHANGE_ME_use_openssl_rand_-base64_32

# --- MinIO / S3-compatible object storage (container-internal) ---
S3_ACCESS_KEY=ome
S3_SECRET_KEY=CHANGE_ME_use_openssl_rand_-base64_32
S3_BUCKET=ome-media

# --- Backend auth secrets — each must be a distinct random value ---
JWT_SECRET=CHANGE_ME_use_openssl_rand_-base64_48
GIFT_CARD_HMAC_SECRET=CHANGE_ME_use_openssl_rand_-base64_48

LOG_LEVEL=info

# --- Storefront: which website/store view this deployment serves ---
# Matches the seeded reference data (see prisma/seed.ts) — change only if
# you've seeded a different website/store-view code.
WEBSITE_CODE=us_retail
STORE_VIEW_ID=1

# --- Order transactional email (confirmation/shipment/cancellation/refund) ---
# Real SMTP only once SMTP_USER/SMTP_PASS are BOTH set — leave them blank to
# keep the log-only simulated sender (fine for a demo/staging deployment).
# For Gmail or Google Workspace: SMTP_USER is the full address; SMTP_PASS
# must be a 16-character App Password (https://myaccount.google.com/apppasswords),
# NOT the account's normal login password — Gmail requires 2-Step
# Verification to be on before it will even offer creating one. SMTP_HOST/
# SMTP_PORT already default to Gmail's own settings, so they're optional.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Shown as the From address — defaults to SMTP_USER when left blank.
SMTP_FROM=

# --- Public domain ---
# Single domain for both apps: storefront at the root, admin at /admin (see
# deploy/nginx.conf + apps/admin/next.config.ts's basePath). Only ONE DNS A
# record is needed — no admin./shop. subdomains. Also feeds the storefront's
# SITE_URL and deploy/init-certbot.sh's certificate request — you must ALSO
# hardcode this same value into deploy/nginx.conf's YOUR_DOMAIN_HERE
# placeholders (nginx has no env-var substitution the way Caddy did).
DOMAIN=www.example.com

# --- Let's Encrypt: used once by deploy/init-certbot.sh to register the
# certificate (expiry-notice emails only, not used for anything else) ---
LETSENCRYPT_EMAIL=you@example.com
