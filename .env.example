# Copy to .env and adjust. Single-tenant: one DB per client deployment.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Infra (matches docker-compose.yml)
DATABASE_URL="postgresql://ome:ome@localhost:5432/omecommerce?schema=public"
REDIS_URL="redis://localhost:6379"
OPENSEARCH_URL="http://localhost:9200"

# MinIO / S3
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="ome"
S3_SECRET_KEY="ome-secret"
S3_BUCKET="ome-media"

# Auth — generate a real secret for anything beyond local dev
JWT_SECRET="dev-only-secret-change-me-in-prod"
# Gift card code hashing — a separate secret from JWT_SECRET (different
# cryptographic purpose); generate a real secret for anything beyond local dev
GIFT_CARD_HMAC_SECRET="dev-only-giftcard-secret-change-me-in-prod"

# Order transactional email — leave SMTP_USER/SMTP_PASS blank to keep the
# log-only simulated sender. For Gmail/Google Workspace, SMTP_PASS must be an
# App Password (https://myaccount.google.com/apppasswords), not the normal
# account password. SMTP_HOST/SMTP_PORT default to Gmail's own settings.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="you@example.com"
# SMTP_PASS="16-char-app-password"
# SMTP_FROM="you@example.com"
