// =============================================================================
// store.prisma — Website / Store / Store View + Language / Currency / Theme
// Scope foundation. See plan/01-domain-model-and-erd.md §1.
// =============================================================================

model Currency {
  code       String   @id @db.Char(3) // ISO-4217, e.g. "USD"
  symbol     String
  minorUnits Int      @default(2) @map("minor_units")
  name       String
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  websitesBase Website[]   @relation("WebsiteBaseCurrency")
  storeViews   StoreView[]

  // Exactly one default currency enforced by a partial unique index (raw SQL),
  // same pattern as Website.isDefault/AttributeSet.isDefault/CustomerGroup.isDefault.
  // Drives the default pre-filled currency in the admin's "New Price List" dialog.
  @@map("currency")
}

model Language {
  id         BigInt   @id @default(autoincrement())
  code       String   @unique // BCP-47, e.g. "en-US"
  name       String
  nativeName String   @map("native_name")
  isRtl      Boolean  @default(false) @map("is_rtl")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  storeViews StoreView[]

  @@map("language")
}

model Theme {
  id        BigInt    @id @default(autoincrement())
  code      String    @unique
  name      String
  config    Json      @default("{}") @db.JsonB
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  storeViews StoreView[]

  @@map("theme")
}

model Website {
  id               BigInt    @id @default(autoincrement())
  publicId         String    @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code             String    @unique @db.Citext // e.g. "us_retail"
  name             String
  baseCurrency     String    @map("base_currency") @db.Char(3)
  defaultStoreId   BigInt?   @map("default_store_id") // FK added via raw SQL (deferred cycle)
  isDefault        Boolean   @default(false) @map("is_default")
  /// This website's own GST registration — single-registration/single-state
  /// scope (a seller registered in multiple states would need this per
  /// warehouse instead; not built, see gst.ts's header comment).
  gstin            String?   @db.VarChar(15)
  /// 2-digit CBIC GST state/UT code this website is registered in — compared
  /// against an order's shipping OrderAddress.stateCode to decide CGST+SGST
  /// (match) vs IGST (no match).
  originStateCode  String?   @map("origin_state_code") @db.Char(2)
  /// When true, every catalog/price-list price on this website is the FINAL
  /// price the customer pays (GST already baked in, MRP-style) — tax is
  /// backed out of it at checkout instead of added on top. When false
  /// (default, matches every website created before this column existed),
  /// prices are tax-exclusive and GST is added on top, unchanged behavior.
  pricesIncludeTax Boolean   @default(false) @map("prices_include_tax")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        BigInt?   @map("created_by")
  updatedBy        BigInt?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  currency Currency @relation("WebsiteBaseCurrency", fields: [baseCurrency], references: [code])
  stores   Store[]

  // Exactly one default website enforced by a partial unique index (raw SQL).
  @@index([deletedAt])
  @@map("website")
}

model Store {
  id                 BigInt    @id @default(autoincrement())
  publicId           String    @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  websiteId          BigInt    @map("website_id")
  code               String    @db.Citext
  name               String
  rootCategoryId     BigInt?   @map("root_category_id") // FK -> category (raw SQL; avoids cycle)
  defaultStoreViewId BigInt?   @map("default_store_view_id") // FK -> store_view (raw SQL)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          BigInt?   @map("created_by")
  updatedBy          BigInt?   @map("updated_by")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  website        Website          @relation(fields: [websiteId], references: [id])
  storeViews     StoreView[]
  warehouseLinks StoreWarehouse[]

  @@unique([websiteId, code])
  @@index([deletedAt])
  @@map("store")
}

model StoreView {
  id         BigInt          @id @default(autoincrement())
  publicId   String          @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  storeId    BigInt          @map("store_id")
  code       String          @db.Citext
  languageId BigInt          @map("language_id")
  currency   String          @db.Char(3)
  themeId    BigInt?         @map("theme_id")
  isRtl      Boolean         @default(false) @map("is_rtl")
  sortOrder  Int             @default(0) @map("sort_order")
  status     StoreViewStatus @default(ACTIVE)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy  BigInt?         @map("created_by")
  updatedBy  BigInt?         @map("updated_by")
  deletedAt  DateTime?       @map("deleted_at") @db.Timestamptz(6)

  store       Store    @relation(fields: [storeId], references: [id])
  language    Language @relation(fields: [languageId], references: [id])
  currencyRef Currency @relation(fields: [currency], references: [code])
  theme       Theme?   @relation(fields: [themeId], references: [id])

  attributeLabels AttributeLabel[]

  @@unique([storeId, code])
  @@index([deletedAt])
  @@map("store_view")
}
