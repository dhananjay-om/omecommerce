// ---------------------------------------------------------------------------
// Stored value: gift cards, wallet, store credit (plan/10-gift-cards-wallet-store-credit.md)
// ---------------------------------------------------------------------------

enum WalletStatus {
  ACTIVE
  FROZEN
}

/// Store Credit and Wallet are the SAME ledger, differentiated by bucket
/// (plan/10 §1) — not two separate systems. No separate REFUND bucket: per
/// plan/10 §4.2, a refund lands in STORE_CREDIT with source=REFUND — adding a
/// distinct REFUND bucket would create two competing ways to represent the
/// same fact (schema-reviewer finding).
enum WalletBucket {
  STORE_CREDIT
  PREPAID_TOPUP
  CASHBACK
  LOYALTY_CONVERSION
}

/// No HOLD/RELEASE value — checkout tender holds (plan/15 Phase 5,
/// StoredValueHold) move no balance while HELD, so placing/releasing one
/// never writes a wallet_transaction row at all (StoredValueHold's own
/// status is the audit trail for that, same as StockReservation is for
/// inventory holds). Only a captured hold writes a real ledger row, and it's
/// an ordinary DEBIT (source ORDER, below) — no new type needed for it.
enum WalletTxnType {
  CREDIT
  DEBIT
  ADJUST
  EXPIRE
}

enum WalletSource {
  REFUND
  RETURN
  GOODWILL
  TOPUP
  CASHBACK
  LOYALTY
  GIFTCARD_LOAD
  PROMO
  ADMIN_ADJUST
  REFERRAL
  /// A checkout-tender hold captured against a paid order (plan/15 Phase 5) —
  /// appended, not inserted, per this enum's append-only convention.
  ORDER
}

/// Checkout tender instrument (plan/15 Phase 5, CartTender/StoredValueHold).
/// Written to accept a third value additively in a later phase (Net-30
/// credit terms) — not built this pass.
enum TenderType {
  WALLET
  GIFT_CARD
}

/// Same 4-state shape as ReservationStatus (inventory.prisma) — HELD is the
/// StockReservation ACTIVE equivalent, deliberately named differently so
/// "a stored-value hold is HELD" reads naturally next to "on_hand -
/// reserved" elsewhere, without implying it's the exact same concept.
enum StoredValueHoldStatus {
  HELD
  CAPTURED
  RELEASED
  EXPIRED
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  DISABLED
  PENDING
}

enum GiftCardKind {
  DIGITAL
  PHYSICAL
}

/// PURCHASED (buying a virtual gift-card product) is deferred — needs an
/// OrderPaid event consumer this pass doesn't build. REFUND (issuing a new
/// card as a refund substitute, plan/10 §3.3) is included even though no
/// use-case emits it yet — trivial to declare, unlike PURCHASED.
enum GiftCardSource {
  ADMIN_ISSUED
  PROMOTIONAL
  REFUND
}

enum GiftCardTxnType {
  ISSUE
  REDEEM
  REFUND
  ADJUST
  VOID
  EXPIRE
}

