enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

/// Order-level status. Independent of FinancialStatus/FulfillmentStatus, which
/// track payment and shipping progress separately (plan/08 §1 "two decoupled
/// state machines" — this third, coarser status is the merchant-facing summary).
/// CONFIRMED/CLOSED added plan/15 Phase 0a, appended (not inserted at their
/// semantically-nearest position) so the physical Postgres enum ordinal order
/// matches this file's declaration order exactly — same convention as
/// WalletSource's REFERRAL value below (`ALTER TYPE ... ADD VALUE` with no
/// BEFORE/AFTER always appends). CONFIRMED sits conceptually between PENDING
/// (cart just converted, payment not yet settled) and PROCESSING (fulfillment
/// underway); CLOSED is a terminal merchant-initiated state distinct from
/// COMPLETED (see CloseOrder's guards: fully delivered, no pending
/// shipment/refund) — the list's *textual* order doesn't reflect lifecycle
/// order, intentionally, to keep the migration's ADD VALUE statements trivial.
enum OrderStatus {
  PENDING
  PROCESSING
  ON_HOLD
  COMPLETED
  CANCELLED
  CONFIRMED
  CLOSED
}

/// PARTIALLY_PAID/FAILED added plan/15 Phase 0a, appended (see OrderStatus's
/// comment above for why). PARTIALLY_PAID covers split-tender orders (e.g.
/// wallet + gateway) where only part of the grand total has settled; FAILED
/// covers a capture attempt that didn't succeed (distinct from VOIDED, which
/// is an authorization explicitly released before capture).
enum FinancialStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
  PARTIALLY_PAID
  FAILED
}

/// Order-level fulfillment progress (aggregate across all order_line rows).
enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
}

/// A single fulfillment/shipment record's own lifecycle (distinct from the
/// order-level FulfillmentStatus aggregate above). PACKED appended plan/15
/// Phase 0a (see OrderStatus's comment on why appended, not inserted).
enum ShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELLED
  PACKED
}

enum AddressType {
