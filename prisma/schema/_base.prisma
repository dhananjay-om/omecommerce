// Loyalty (plan/11-loyalty-and-referral.md) — points ledger. Reuses
// WalletStatus for LoyaltyAccount.status (ACTIVE/FROZEN) — same concept, no
// duplicate enum needed.
// ---------------------------------------------------------------------------

enum LoyaltyProgramStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum LoyaltyTxnType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
  REVERSE
}

/// Simplified from plan/11's many trigger types (order_paid/product_purchase/
/// signup/review/birthday/referral/newsletter/social/custom) — only
/// order-paid earning is built this pass. CUSTOMER = self-service redemption
/// (POST /store/v1/me/loyalty/actions/redeem), distinct from ADMIN
/// (an admin-initiated grant/correction).
enum LoyaltySource {
  ORDER
  ADMIN
  CUSTOMER
  EXPIRE
  REVERSAL
  REFERRAL
}

// ---------------------------------------------------------------------------
// Referral (plan/11-loyalty-and-referral.md §3) — referrer/referee tracking +
// rewards. Reuses LoyaltyProgramStatus for ReferralProgram.status (ACTIVE/
// PAUSED/ENDED) — same concept, same reuse precedent as LoyaltyAccount.status
// reusing WalletStatus. Reward issuance reuses WalletLedger.credit (source
// REFERRAL, added above) and LoyaltyLedger.earn (source REFERRAL, added
// above) directly rather than a new ledger of its own.
// ---------------------------------------------------------------------------

/// SIGNUP: referrer is rewarded as soon as the referee attaches the code.
/// FIRST_ORDER: referrer is rewarded when the referee's first qualifying
/// paid order arrives (optionally gated on ReferralProgram.minOrderAmount).
enum ReferralQualifyingEvent {
  SIGNUP
  FIRST_ORDER
}

/// Only the two reward types this pass can actually issue through an
/// existing ledger — no GIFT_CARD (real extra work: HMAC code generation,
/// see issue-gift-card.usecase.ts) or COUPON (a Coupon module exists now,
/// coupon.prisma, but referral hasn't been wired to auto-generate/issue one —
/// separate future work, not part of this pass).
enum ReferralRewardType {
  STORE_CREDIT
  POINTS
}

/// No INVITED state (this pass has no pre-signup click/attribution tracking
/// — see referral.prisma's header) and no REJECTED state (no admin
/// fraud-review queue this pass) — a referral is either progressing
/// normally, EXPIRED (missed its attribution window), or REVERSED (the
/// qualifying order was refunded after the referrer's reward was granted —
/// schema-reviewer finding: this status transition, not a mutable
/// ReferralReward row, is the system of record for "was this clawed back",
/// keeping ReferralReward a truly immutable one-time-grant row like every
/// other ledger/grant table in this schema).
enum ReferralStatus {
  SIGNED_UP
  QUALIFIED
  REWARDED
  EXPIRED
  REVERSED
}

enum ReferralBeneficiary {
  REFERRER
  REFEREE
}

/// Who triggered an order_status_history row (plan/15 Phase 0b). SYSTEM covers
/// checkout-saga-driven transitions (e.g. OrderPaid) where no admin acted.
enum OrderHistoryActorType {
  ADMIN
  SYSTEM
  CUSTOMER
}

/// plan/15 Phase 0b — internal notes are admin-only (never returned to the
/// storefront); customer notes are shown on both the admin detail page and the
/// customer's own order detail page.
enum OrderNoteType {
  INTERNAL
  CUSTOMER
}

/// plan/15 Phase 1 — an invoice is created and issued in one admin action (no
/// separate "issue" step exists in this pass' API surface), so every row this
/// codebase writes today is ISSUED. DRAFT is declared for forward-compat with
/// a future draft/preview workflow, matching this schema's general practice of
/// declaring the full documented model even when only part of it is wired.
enum InvoiceStatus {
  DRAFT
  ISSUED
}

/// plan/15 Phase 3 — email sending is simulated by default (SimulatedEmailSender,
/// same precedent as TestPaymentGateway); FAILED covers a real provider adapter
/// throwing in the future, exercised today only if the simulated sender itself
/// is made to fail (it isn't).
enum EmailLogStatus {
  SENT
  FAILED
}

/// The email "type" a manual Send Email action can trigger (plan/15 Phase 3).
/// CUSTOM carries an admin-supplied subject/body instead of a template.
enum OrderEmailType {
  CONFIRMATION
  INVOICE
  SHIPMENT
  CANCELLATION
  REFUND
  CUSTOM
}

/// coupon.prisma — PERCENTAGE is currency-agnostic (Coupon.currency must be
/// NULL); FIXED_AMOUNT is a specific amount (Coupon.currency must be set).
/// Enforced by CHECK constraints, not just app validation — see
/// prisma/migrations/<coupon migration>/migration.sql.
enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// coupon.prisma — CART is the original MVP behavior (discount base = whole
/// cart subtotal, zero CouponCondition rows allowed). ITEM restricts the
/// discount base to only the cart lines matching the coupon's conditions
/// (requires >=1 CouponCondition row) — enforced by a CHECK constraint plus
/// app-layer validation in create/update-coupon.usecase.ts.
enum CouponTargetType {
  CART
  ITEM
}

/// coupon.prisma — which column pair on CouponCondition is populated. PRODUCT
/// conditions on one coupon OR together (any of these products); CATEGORY
/// conditions OR together, ancestor-inclusive; ATTRIBUTE conditions group BY
/// attributeId and OR within the same attribute — see condition-matcher.ts
/// for the full AND-across-groups/OR-within-group algorithm.
enum CouponConditionType {
  PRODUCT
  CATEGORY
  ATTRIBUTE
}

/// order.prisma's OrderTaxLine — India GST split. CGST+SGST (each half the
/// combined TaxClass.rate) for an intra-state sale (customer's state == the
/// selling Website's originStateCode), IGST (the full rate) for inter-state.
/// Union Territories without their own legislature are labeled SGST here too
/// (documented simplification — the rate math is identical, only the invoice
/// label differs; see native-tax-calculator.ts's header comment).
enum GstTaxType {
  CGST
  SGST
  IGST
}

/// company.prisma — B2B company approval workflow (plan/15 Phase 6). New
/// companies default to PENDING (self-registered or admin-created but not
/// yet vetted); an admin moves it to ACTIVE (members can shop under its
/// pricing/tax terms) or REJECTED (never was legitimate). SUSPENDED is a
/// separate reversible state from ACTIVE (temporary hold, e.g. billing
/// dispute) — modeled as its own state rather than a boolean so the history
/// of "was this ever active" isn't lost the way a single isActive flip would
/// lose it. Only ACTIVE companies are honored by CompanyMembershipLookup
/// (pricing/tax-exemption resolution) and by checkout.
enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

/// company.prisma's CompanyCustomer — ADMIN can manage the company's own
/// buyer list (storefront /account/company member add/remove/role-change);
/// BUYER can only shop under the company's pricing/tax-exemption. No
/// spending-approval chain this pass (see company.prisma's header comment),
/// so the two roles differ only in member-management access, not in
/// ordering ability.
enum CompanyMemberRole {
  ADMIN
  BUYER
}
