// =============================================================================
// OMEcommerce — Prisma schema (Foundation: Store + Catalog core)
// _base.prisma : datasource, generator, extensions, shared enums
// -----------------------------------------------------------------------------
// Multi-file schema (prisma/schema/*.prisma). Requires Prisma >= 5.15.
// Conventions (see plan/02-prisma-schema-and-migrations.md):
//   - BigInt identity PKs + external UUIDv7 `publicId`
//   - snake_case in DB via @map / @@map ; camelCase in TS
//   - all timestamps @db.Timestamptz ; money Decimal(18,4)
//   - soft delete via nullable deletedAt (enforced by a client extension)
//   - Scope FKs (websiteId/storeId/storeViewId) and audit FKs (createdBy/updatedBy)
//     are kept as PLAIN scalar columns here; their FK constraints, CHECKs, generated
//     columns, partitioning and specialized indexes live in prisma/sql/*.sql
//     (hand-appended to the generated migration). This keeps Website/Store/StoreView
//     free of dozens of noisy back-relations.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "prismaSchemaFolder"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, ltree, pg_trgm, btree_gin]
}

