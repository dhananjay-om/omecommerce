// =============================================================================
// OMEcommerce — AI Insights (Track 1 of the AI features plan)
// -----------------------------------------------------------------------------
// A derived read model, same posture as analytics.prisma's summary_* tables
// (see that file's own header comment for the full convention this follows):
// nothing outside the AI refresh worker/use case ever writes here. Every rule
// reads the EXISTING analytics summary tables (src/modules/analytics) via
// AnalyticsQueryRepository — this table stores the rules' OUTPUT, not new raw
// aggregation. Explicitly not LLM-generated: every row here is the result of
// a plain threshold rule over real numbers, same "explainable, not a model
// guess" philosophy the Dashboard's own ai-insights.tsx already established
// (see that component's header comment) — this table is that same pattern's
// persisted, exhaustive version, not a different kind of "AI".
// =============================================================================

/// One row per generated insight. `dateKey` is the day the underlying
/// trailing-window comparison closed on (matches analytics' YYYYMMDD
/// convention, src/modules/analytics/domain/date-key.ts's dateKeyOf — reused
/// directly, not reimplemented). `ruleCode` is a fixed vocabulary in
/// application code (REVENUE_DROP/REVENUE_UP/OUT_OF_STOCK/LOW_STOCK/
/// PAYMENT_FAILURE_SPIKE/RETURN_RATE_UP/ORDER_STUCK/FULFILLMENT_SLOWDOWN/
/// NEW_CUSTOMERS/...) — String, not an enum, same "a summary table must
/// never fail to write because a new rule was added" reasoning as
/// SummaryOrderStatusDaily.status.
///
/// No per-entity column (e.g. a future per-SKU rule's variant/product id) in
/// this first pass — every Phase 1 rule is a whole-website metric, and a
/// nullable column in a unique constraint needs `NULLS NOT DISTINCT` (raw
/// SQL, not expressible in Prisma's schema DSL — see prisma/README.md) to
/// actually dedupe on refresh; not worth that machinery for a column nothing
/// writes yet. Add it back in its own migration once a real per-entity rule
/// needs it.
model AiInsight {
  id          BigInt   @id @default(autoincrement())
  publicId    String   @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  dateKey     Int      @map("date_key")
  websiteId   BigInt   @map("website_id")
  ruleCode    String   @map("rule_code")
  category    String
  impact      String
  headline    String
  actionLabel String   @map("action_label")
  actionHref  String   @map("action_href")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([dateKey, websiteId, ruleCode], map: "ux_ai_insight_date_website_rule")
  @@index([websiteId, dateKey])
  @@map("ai_insight")
}

/// Admin-configurable LLM provider credentials (currently just OpenAI),
/// backing whatever future LLM-based feature reads it (AI Assistant first —
/// this table intentionally has no reader yet, it's the key-management
/// piece that ships ahead of the feature that will consume it). Same
/// singleton/plaintext-with-documented-tradeoff shape as EmailSettings
/// (system.prisma) — deliberately mirrored, not reinvented:
///
/// A true singleton — at most one row ever exists, enforced at the
/// application layer (`findFirst()` then update-or-create), not a DB
/// constraint — same as EmailSettings itself; that model's own repository
/// comment incorrectly claims a DB-level unique index enforces this, but no
/// such index exists in its schema either, so don't copy that claim here.
///
/// `apiKey` is stored in plaintext, not hashed — same reasoning as
/// EmailSettings.password: the app must present the ORIGINAL key to OpenAI
/// on every call, so only reversible storage is possible without a
/// symmetric-encryption key this project doesn't have anywhere yet. Same
/// real exposure delta as that column (rides along in backups/replicas,
/// unlike JWT_SECRET/GIFT_CARD_HMAC_SECRET which are env-var-only) —
/// mitigated the same way: GetAiSettings never returns this column's
/// value, only whether one is set.
model AiSettings {
  id        BigInt   @id @default(autoincrement())
  publicId  String   @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  /// Fixed vocabulary in application code ('openai' today) — String, not an
  /// enum, so adding a second provider later needs no migration. Only
  /// 'openai' is actually wired to anything; the admin UI doesn't offer a
  /// picker for providers that don't work yet.
  provider  String   @default("openai")
  apiKey    String   @map("api_key")
  model     String   @default("gpt-4o-mini")
  /// Lets a saved key be temporarily disabled without deleting it (e.g. to
  /// pause spend) — checked by getOpenAiClient before the DB row is even
  /// considered "configured".
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  @@map("ai_settings")
}

/// One row per (day, website, product) with a real forecastable sales
/// signal — same "derived, refreshed not live-queried" posture as
/// AiInsight, same nightly cadence (see src/workers/ai-refresh.worker.ts).
/// Product-grain, not variant-grain — same simplification
/// SummaryProductDaily itself already made for the same reason (see that
/// model's own doc comment in analytics.prisma): most catalog items here
/// are SIMPLE products with one implicit variant. `currentStock` sums
/// stock_item.available across every variant/warehouse of the product.
/// Deliberately NOT LLM-based — a plain trailing-window moving average,
/// same "explainable, not a model guess" philosophy as AiInsight.
///
/// A product with zero recent sales gets no row at all (not a forecastable
/// signal) — refreshForecasts deletes any existing row for a product that
/// drops out, same "clear what's no longer true" reasoning as
/// PrismaAiInsightRepository.refreshInsights.
model ProductForecast {
  id               BigInt   @id @default(autoincrement())
  publicId         String   @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  dateKey          Int      @map("date_key")
  websiteId        BigInt   @map("website_id")
  productId        BigInt   @map("product_id")
  /// Trailing-14-day units sold ÷ 14 — units are currency-agnostic, so
  /// this sums across every currency SummaryProductDaily tracked for the
  /// product, unlike money-keyed reads elsewhere in this schema.
  avgDailySellRate Decimal  @map("avg_daily_sell_rate") @db.Decimal(10, 4)
  /// Percent change, most-recent-7-days average vs. the 7 days before —
  /// null when the earlier window had zero sales (an undefined
  /// percentage, not zero).
  trendPct         Decimal? @map("trend_pct") @db.Decimal(10, 2)
  currentStock     Int      @map("current_stock")
  /// currentStock ÷ avgDailySellRate — null when avgDailySellRate is 0
  /// (an "infinite" cover isn't a meaningful number to show; this row
  /// wouldn't exist in that case anyway, see the model doc comment above).
  daysOfCover      Decimal? @map("days_of_cover") @db.Decimal(10, 2)
  /// Fixed vocabulary in application code ('high'/'medium'/'low', by
  /// daysOfCover thresholds) — String, not an enum, same reasoning as
  /// AiInsight.impact.
  riskTier         String   @map("risk_tier")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([dateKey, websiteId, productId], map: "ux_product_forecast_date_website_product")
  @@index([websiteId, dateKey])
  @@index([riskTier])
  @@map("product_forecast")
}

/// One row per generated suggestion — the fourth and last AI features
/// concern in this module. Same "derived, refreshed not live-queried"
/// posture as AiInsight/ProductForecast, same nightly cadence (folded into
/// the same ai-refresh.worker.ts job, run third — after ProductForecast,
/// since the RESTOCK/PROMOTE_SLOW_MOVER kinds read that table's own
/// output directly rather than re-deriving it). Deliberately NOT
/// LLM-based, same "explainable" philosophy as the rest of this module.
///
/// `kind` is a fixed vocabulary in application code
/// (RESTOCK/PROMOTE_SLOW_MOVER/FEATURE_TRENDING_CATEGORY) — String, not an
/// enum, same reasoning as AiInsight.ruleCode. `targetType`/`targetId`
/// generalize AiInsight's whole-website-only scope to a specific
/// product/category, since every suggestion here is inherently about one
/// entity, unlike most Insight rules.
///
/// `impactScore` is a real computed number, but genuinely different units
/// per `kind` (documented in the rule engine) — good enough for a
/// reasonable default sort, not claimed to be a precisely comparable
/// cross-kind metric. `confidence` is a tier based on how much real data
/// backs the signal, not a fabricated ML score — same "explainable, not
/// fake precision" posture as every tier elsewhere in this module.
///
/// No "apply" action — every suggestion's actionHref links to the real
/// admin page where a merchant would act on it themselves (same
/// convention as AiInsight.actionHref); there's no generic "apply this
/// suggestion" primitive in this codebase, and building bespoke
/// automation per kind (e.g. auto-creating a coupon) is a separate, much
/// larger feature, deliberately not built here.
model MerchandisingSuggestion {
  id          BigInt   @id @default(autoincrement())
  publicId    String   @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  dateKey     Int      @map("date_key")
  websiteId   BigInt   @map("website_id")
  kind        String
  targetType  String   @map("target_type") // 'PRODUCT' | 'CATEGORY'
  targetId    BigInt   @map("target_id")
  headline    String
  rationale   String
  impactScore Decimal  @map("impact_score") @db.Decimal(12, 2)
  confidence  String
  actionLabel String   @map("action_label")
  actionHref  String   @map("action_href")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([dateKey, websiteId, kind, targetType, targetId], map: "ux_merch_suggestion_date_website_kind_target")
  @@index([websiteId, dateKey])
  @@map("merchandising_suggestion")
}
