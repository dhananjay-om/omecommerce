// =============================================================================
// OMEcommerce — AI Insights (Track 1 of the AI features plan)
// -----------------------------------------------------------------------------
// A derived read model, same posture as analytics.prisma's summary_* tables
// (see that file's own header comment for the full convention this follows):
// nothing outside the AI refresh worker/use case ever writes here. Every rule
// reads the EXISTING analytics summary tables (src/modules/analytics) via
// AnalyticsQueryRepository — this table stores the rules' OUTPUT, not new raw
// aggregation. Explicitly not LLM-generated: every row here is the result of
// a plain threshold rule over real numbers, same "explainable, not a model
// guess" philosophy the Dashboard's own ai-insights.tsx already established
// (see that component's header comment) — this table is that same pattern's
// persisted, exhaustive version, not a different kind of "AI".
// =============================================================================

/// One row per generated insight. `dateKey` is the day the underlying
/// trailing-window comparison closed on (matches analytics' YYYYMMDD
/// convention, src/modules/analytics/domain/date-key.ts's dateKeyOf — reused
/// directly, not reimplemented). `ruleCode` is a fixed vocabulary in
/// application code (REVENUE_DROP/REVENUE_UP/OUT_OF_STOCK/LOW_STOCK/
/// PAYMENT_FAILURE_SPIKE/RETURN_RATE_UP/ORDER_STUCK/FULFILLMENT_SLOWDOWN/
/// NEW_CUSTOMERS/...) — String, not an enum, same "a summary table must
/// never fail to write because a new rule was added" reasoning as
/// SummaryOrderStatusDaily.status.
///
/// No per-entity column (e.g. a future per-SKU rule's variant/product id) in
/// this first pass — every Phase 1 rule is a whole-website metric, and a
/// nullable column in a unique constraint needs `NULLS NOT DISTINCT` (raw
/// SQL, not expressible in Prisma's schema DSL — see prisma/README.md) to
/// actually dedupe on refresh; not worth that machinery for a column nothing
/// writes yet. Add it back in its own migration once a real per-entity rule
/// needs it.
model AiInsight {
  id          BigInt   @id @default(autoincrement())
  publicId    String   @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  dateKey     Int      @map("date_key")
  websiteId   BigInt   @map("website_id")
  ruleCode    String   @map("rule_code")
  category    String
  impact      String
  headline    String
  actionLabel String   @map("action_label")
  actionHref  String   @map("action_href")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([dateKey, websiteId, ruleCode], map: "ux_ai_insight_date_website_rule")
  @@index([websiteId, dateKey])
  @@map("ai_insight")
}

/// Admin-configurable LLM provider credentials (currently just OpenAI),
/// backing whatever future LLM-based feature reads it (AI Assistant first —
/// this table intentionally has no reader yet, it's the key-management
/// piece that ships ahead of the feature that will consume it). Same
/// singleton/plaintext-with-documented-tradeoff shape as EmailSettings
/// (system.prisma) — deliberately mirrored, not reinvented:
///
/// A true singleton — at most one row ever exists, enforced at the
/// application layer (`findFirst()` then update-or-create), not a DB
/// constraint — same as EmailSettings itself; that model's own repository
/// comment incorrectly claims a DB-level unique index enforces this, but no
/// such index exists in its schema either, so don't copy that claim here.
///
/// `apiKey` is stored in plaintext, not hashed — same reasoning as
/// EmailSettings.password: the app must present the ORIGINAL key to OpenAI
/// on every call, so only reversible storage is possible without a
/// symmetric-encryption key this project doesn't have anywhere yet. Same
/// real exposure delta as that column (rides along in backups/replicas,
/// unlike JWT_SECRET/GIFT_CARD_HMAC_SECRET which are env-var-only) —
/// mitigated the same way: GetAiSettings never returns this column's
/// value, only whether one is set.
model AiSettings {
  id        BigInt   @id @default(autoincrement())
  publicId  String   @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  /// Fixed vocabulary in application code ('openai' today) — String, not an
  /// enum, so adding a second provider later needs no migration. Only
  /// 'openai' is actually wired to anything; the admin UI doesn't offer a
  /// picker for providers that don't work yet.
  provider  String   @default("openai")
  apiKey    String   @map("api_key")
  model     String   @default("gpt-4o-mini")
  /// Lets a saved key be temporarily disabled without deleting it (e.g. to
  /// pause spend) — checked by getOpenAiClient before the DB row is even
  /// considered "configured".
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")

  @@map("ai_settings")
}
