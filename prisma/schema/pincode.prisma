// =============================================================================
// pincode.prisma — Delivery-serviceability lookup for the storefront PDP.
//
// No delivery-zone/serviceable-area concept exists anywhere else in this
// schema (Warehouse.address is a free-form JSON blob, ShippingMethod is
// flat-rate/global with zero geography targeting — see inventory.prisma/
// order.prisma's own doc comments) — this is a small, standalone, admin-
// curated list, not a computed radius-from-warehouse feature (no geocoding
// exists in this system, and fabricating a distance-based estimate would be
// exactly the kind of "made-up number presented as fact" this project has
// deliberately avoided everywhere else — see the AI module's own
// "explainable, not a model guess" posture). A pincode not in this table
// reads as "not serviceable yet," honestly, rather than guessing.
// =============================================================================

model ServiceablePincode {
  id            BigInt   @id @default(autoincrement())
  publicId      String   @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  /// India 6-digit PIN code.
  code          String   @unique @db.VarChar(6)
  city          String
  state         String
  estimatedDays Int      @map("estimated_days")
  codAvailable  Boolean  @default(true) @map("cod_available")
  /// Toggle off without deleting — same "isActive, not a delete" convention
  /// as PriceList/Coupon/AiSettings elsewhere in this schema.
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     BigInt?  @map("created_by")
  updatedBy     BigInt?  @map("updated_by")

  @@map("serviceable_pincode")
}
