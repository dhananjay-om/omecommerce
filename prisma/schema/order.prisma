// =============================================================================
// order.prisma — Tax classes, shipping methods, cart, order lifecycle, payments,
// fulfillment, returns. See plan/08-order-management.md.
//
// SCOPE FOR THIS PASS (documented deliberate simplifications, not silent gaps):
// - TaxPort/ShippingPort are minimal NATIVE implementations (tax_class flat rate;
//   shipping_method flat rate) behind the ports decided in plan/00 §9 ("native +
//   adapter interface"). A pluggable Avalara/TaxJar-style adapter is future work;
//   the port boundary (src/modules/order/domain/ports.ts) is where it plugs in.
// - `order.discountTotal`/`order.couponCode` are now real, written by CompleteCheckout
//   (coupon.prisma) — a deliberately-scoped MVP (one whole-cart coupon per order, no
//   catalog/cart rule engine, no per-line discount allocation, no stacking). The
//   original full "Promotion" bounded context (plan/00 §… cart rules + catalog rules
//   + condition-tree builder) remains out of scope, same as it always has been.
// - `OrderInvoice`/`OrderInvoiceLine` (plan/15 Phase 1) added a real invoice
//   document + per-website numbering (invoice_number_counter, same
//   next_order_number()-style guarded sequence). Supports partial invoicing
//   (multiple invoices per order) the same way Fulfillment supports partial
//   shipment. `qtyInvoiced` per order_line stays derivable (SUM over
//   order_invoice_line), not a denormalized column — same reasoning as
//   fulfilledQty/refundedQty being the only counters that DO get a column,
//   because those are guarded by a CAS UPDATE on a hot path; invoice qty
//   never needs that.
// - `Cart`/`Order.customerId` are present as bare nullable scalars with NO FK yet —
//   full Customer context (accounts/auth/addresses) is a later stage; guest
//   checkout (customerId=NULL) is the only path exercised today. The FK to
//   `customer(id)` is added once that table exists (expand/migrate/contract,
//   plan/02 §6.2). `CartLine` does NOT snapshot a price — prices are always
//   re-resolved live at checkout (plan/05 §2.3: "never trust stale totals").
// - `order_line` has no `product_id` (only `variant_id`) — derivable via
//   `variant.product_id`; kept as a single source of truth rather than a
//   denormalized, sync-requiring second column.
// - plan/08's separate `shipment` concept is folded into `Fulfillment`
//   (`trackingNumber`/`carrier`/`shippedAt` live there directly) — one write, one
//   less join, no loss of information at this scale.
// - `order_number` is a real per-website atomic sequence (order_number_counter +
//   a guarded UPDATE via next_order_number(), plan/08 §5), not just the internal id.
// - No partitioning yet on `order`/`order_line` despite plan/08 §7's 50M-order
//   target — deferred to Stage 6 (plan/12 §5), same as stock_movement. A BRIN
//   index on `order.created_at` is the interim mitigation, mirroring
//   stock_movement's `ix_stock_movement_created_at_brin` precedent exactly.
// =============================================================================

/// Flat-rate native tax classification (plan/00 §9 decision: native + adapter
/// interface). `rate` is a FRACTION (0.0825 = 8.25%), not a percentage, so it
/// composes directly with the scale-4 fixed-point arithmetic in
/// shared/domain/decimal.ts (see prisma/sql/0004_order_raw.sql for the CHECK).
model TaxClass {
  id        BigInt    @id @default(autoincrement())
  publicId  String    @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code      String    @unique @db.Citext
  name      String
  rate      Decimal   @db.Decimal(7, 4)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([deletedAt])
  @@map("tax_class")
}

/// Flat-rate native shipping (plan/01 catalog requirements list "Shipping" as a
/// module; full carrier/zone/rate-table architecture is future work — see
/// plan/09's deployment scope. This is the minimal real implementation the
/// checkout saga needs today.)
model ShippingMethod {
  id        BigInt    @id @default(autoincrement())
  publicId  String    @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  code      String    @unique @db.Citext
  name      String
  flatRate  Decimal   @map("flat_rate") @db.Decimal(18, 4)
  currency  String    @db.Char(3) // scope scalar; FK added in raw SQL
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([deletedAt])
  @@map("shipping_method")
}

/// Guarded per-website order-number sequence (plan/08 §5). One row per website;
/// `nextNumber` is advanced via a race-safe UPDATE...RETURNING (next_order_number()
/// in raw SQL), same pattern as the inventory/wallet ledgers.
model OrderNumberCounter {
  websiteId  BigInt @id @map("website_id")
  nextNumber BigInt @default(1) @map("next_number")

  @@map("order_number_counter")
}

/// Guarded per-website invoice-number sequence (plan/15 Phase 1) — identical
/// pattern to OrderNumberCounter above (next_invoice_number() in raw SQL).
model InvoiceNumberCounter {
  websiteId  BigInt @id @map("website_id")
  nextNumber BigInt @default(1) @map("next_number")

  @@map("invoice_number_counter")
}

/// Cart is a domain aggregate whose totals are ALWAYS recomputed server-side at
/// checkout — no price is stored on CartLine (plan/05 §2.3).
model Cart {
  id              BigInt     @id @default(autoincrement())
  publicId        String     @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  websiteId       BigInt     @map("website_id")
  storeViewId     BigInt     @map("store_view_id")
  currency        String     @db.Char(3)
  customerId      BigInt?    @map("customer_id") // FK -> customer(id) ON DELETE SET NULL, added in prisma/sql/0006_customer_raw.sql; NULL = guest
  customerGroupId BigInt?    @map("customer_group_id")
  status          CartStatus @default(ACTIVE)
  /// Applied coupon code, if any — no FK (revalidated live on every read/checkout,
  /// same reasoning as why CartLine doesn't snapshot price). The discount AMOUNT is
  /// deliberately never persisted here, only the code — matches how `subtotal`
  /// itself is recomputed fresh by EnrichCartView rather than cached on Cart.
  couponCode      String?    @map("coupon_code") @db.Citext
  version         Int        @default(0)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines CartLine[]
  order Order?

  @@index([websiteId])
  @@index([storeViewId])
  @@index([customerGroupId])
  @@index([status])
  @@map("cart")
}

model CartLine {
  id        BigInt   @id @default(autoincrement())
  cartId    BigInt   @map("cart_id")
  variantId BigInt   @map("variant_id")
  qty       Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_line")
}

/// The order aggregate. NEVER soft-deleted (cancel, don't delete — plan/08 §2).
/// Money/line/address/tax are all SNAPSHOTTED at placement so later catalog/price
/// changes can never alter a placed order (plan/08 §2, §7).
model Order {
  id                 BigInt            @id @default(autoincrement())
  publicId           String            @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  orderNumber        BigInt            @map("order_number")
  websiteId          BigInt            @map("website_id")
  storeId            BigInt            @map("store_id")
  storeViewId        BigInt            @map("store_view_id")
  cartId             BigInt?           @unique @map("cart_id")
  customerId         BigInt?           @map("customer_id") // FK -> customer(id) ON DELETE RESTRICT, added in prisma/sql/0006_customer_raw.sql; NULL = guest
  customerGroupId    BigInt?           @map("customer_group_id")
  email              String
  currency           String            @db.Char(3)
  status             OrderStatus       @default(PENDING)
  financialStatus    FinancialStatus   @default(PENDING) @map("financial_status")
  fulfillmentStatus  FulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  subtotal           Decimal           @db.Decimal(18, 4)
  discountTotal      Decimal           @default(0) @map("discount_total") @db.Decimal(18, 4)
  taxTotal           Decimal           @map("tax_total") @db.Decimal(18, 4)
  shippingTotal      Decimal           @map("shipping_total") @db.Decimal(18, 4)
  grandTotal         Decimal           @map("grand_total") @db.Decimal(18, 4)
  shippingMethodCode String?           @map("shipping_method_code") // snapshot, not FK
  couponCode         String?           @map("coupon_code") @db.Citext // snapshot, not FK — same reasoning as shippingMethodCode; Citext matches Cart.couponCode/Coupon.code
  customerIp         String?           @map("customer_ip") // plan/15 Phase 0a — req.ip captured at checkout, admin detail page's "Order Information" section
  placedAt           DateTime          @default(now()) @map("placed_at") @db.Timestamptz(6)
  closedAt           DateTime?         @map("closed_at") @db.Timestamptz(6) // plan/15 Phase 4 — set by CloseOrder
  version            Int               @default(0)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // onDelete: Restrict (explicit, not Prisma's implicit SetNull default for optional
  // relations) — a completed order must never have its cart_id silently nulled out
  // by a future cart-purge job (plan/00 §4.6 "cart... partition + drop old"); that
  // job must affirmatively exclude carts with a completed order instead.
  cart             Cart?                @relation(fields: [cartId], references: [id], onDelete: Restrict)
  lines            OrderLine[]
  addresses        OrderAddress[]
  taxLines         OrderTaxLine[]
  payments         PaymentTransaction[]
  fulfillments     Fulfillment[]
  returns          OrderReturn[]
  history          OrderStatusHistory[]
  notes            OrderNote[]
  invoices         OrderInvoice[]
  emailLogs        OrderEmailLog[]
  couponRedemption CouponRedemption?

  @@unique([websiteId, orderNumber])
  @@index([storeId])
  @@index([storeViewId])
  @@index([customerGroupId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("order")
}

/// Line-level snapshot: sku/name/price/tax are frozen at order placement
/// (plan/08 §2 "an order must never change because a product was later edited").
/// Mutable AFTER creation (fulfilledQty/refundedQty advance via later fulfillment/
/// return operations) — unlike payment_transaction/fulfillment_line/etc, so it
/// gets updatedAt + version (optimistic lock) like stock_item, not append-only
/// treatment.
model OrderLine {
  id             BigInt   @id @default(autoincrement())
  orderId        BigInt   @map("order_id")
  variantId      BigInt   @map("variant_id")
  sku            String
  name           String
  qty            Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 4)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 4)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 4)
  rowTotal       Decimal  @map("row_total") @db.Decimal(18, 4)
  taxClassCode   String?  @map("tax_class_code") // snapshot, not FK
  hsnCode        String?  @map("hsn_code") // snapshot, not FK — from Product.hsnCode as of order creation
  fulfilledQty   Int      @default(0) @map("fulfilled_qty")
  refundedQty    Int      @default(0) @map("refunded_qty")
  version        Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant          ProductVariant     @relation(fields: [variantId], references: [id])
  fulfillmentLines FulfillmentLine[]
  returnLines      OrderReturnLine[]
  invoiceLines     OrderInvoiceLine[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_line")
}

/// Immutable address snapshot at time of order (plan/08 §2). At most one row per
/// (order, type) — enforced below, so application code can safely assume a single
/// BILLING and a single SHIPPING row per order.
model OrderAddress {
  id         BigInt      @id @default(autoincrement())
  orderId    BigInt      @map("order_id")
  type       AddressType
  name       String
  company    String?
  line1      String
  line2      String?
  city       String
  region     String?
  /// 2-digit CBIC GST state/UT code (e.g. "27" = Maharashtra) — structured,
  /// unlike the freeform `region` above, so it's usable as a reliable
  /// taxable-jurisdiction key (compared against Website.originStateCode to
  /// decide CGST+SGST vs IGST). Populated by checkout's State dropdown.
  stateCode  String?     @map("state_code") @db.Char(2)
  /// Buyer GSTIN — optional B2B capture, only meaningful on the billing
  /// address but not type-restricted at the DB level (same as every other
  /// optional address field here).
  gstin      String?     @db.VarChar(15)
  postalCode String      @map("postal_code")
  country    String      @db.Char(2)
  phone      String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@map("order_address")
}

/// Per-(tax-class, GST-type) breakdown snapshot (plan/08 §2 order_tax_line) —
/// an intra-state order gets 2 rows per tax class (CGST + SGST, each half the
/// rate); an inter-state order gets 1 (IGST, full rate). taxType is nullable
/// for pre-GST-module historical rows (there weren't any — tax was always 0
/// before this migration — but nullable is the safe, non-breaking choice,
/// same as Order.shippingMethodCode); always set by new code going forward.
model OrderTaxLine {
  id           BigInt      @id @default(autoincrement())
  orderId      BigInt      @map("order_id")
  taxClassCode String      @map("tax_class_code")
  taxType      GstTaxType? @map("tax_type")
  rate         Decimal     @db.Decimal(7, 4)
  amount       Decimal     @db.Decimal(18, 4)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_tax_line")
}

/// Append-only payment ledger (plan/08 §2). Never updated/deleted — a refund is a
/// NEW row with type=REFUND, not an edit to the original CAPTURE row. `raw` keeps
/// the gateway's full response for reconciliation/dispute investigation once
/// `gatewayRef` alone isn't enough (plan/08 §2 explicitly lists this column).
model PaymentTransaction {
  id         BigInt           @id @default(autoincrement())
  orderId    BigInt           @map("order_id")
  method     String
  gateway    String
  type       PaymentTxnType
  amount     Decimal          @db.Decimal(18, 4)
  currency   String           @db.Char(3) // FK'd + trigger-checked == order.currency, raw SQL
  status     PaymentTxnStatus
  gatewayRef String?          @map("gateway_ref")
  raw        Json?            @db.JsonB
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // No standalone @@index([orderId]): the raw-SQL composite index
  // ix_payment_transaction_order_type(order_id, type) already covers orderId-only
  // lookups as its leftmost prefix — an extra single-column index would just be
  // duplicate write amplification.
  @@map("payment_transaction")
}

/// A logistics event (pack + ship). Does NOT deduct stock again — inventory was
/// already deducted when the order's reservations were committed at payment
/// success (plan/07 §3 / plan/08 §4); this only tracks the shipping/tracking side.
model Fulfillment {
  id             BigInt         @id @default(autoincrement())
  publicId       String         @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  orderId        BigInt         @map("order_id")
  warehouseId    BigInt         @map("warehouse_id")
  status         ShipmentStatus @default(PENDING)
  trackingNumber String?        @map("tracking_number")
  carrier        String?
  shippedAt      DateTime?      @map("shipped_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines    FulfillmentLine[]
  tracking ShipmentTracking?

  @@index([orderId])
  @@index([warehouseId])
  @@map("fulfillment")
}

/// Promotes tracking to a first-class, queryable concept (plan/15 Phase 2)
/// without breaking Fulfillment's existing role as the shipment record itself
/// (trackingNumber/carrier/shippedAt stay there — see order.prisma's header).
/// This adds what's missing: a carrier deep-link, an ETA, the carrier's own
/// free-text status (independent of ShipmentStatus, which is OUR lifecycle,
/// not the carrier's), shipping notes, and the packing-slip PDF. One row per
/// Fulfillment (1:1, not append-only) — unlike OrderInvoice, a shipment's
/// tracking info is a single mutable record that gets updated in place as the
/// carrier's status changes, not a new document per update.
model ShipmentTracking {
  id                    BigInt    @id @default(autoincrement())
  fulfillmentId         BigInt    @unique @map("fulfillment_id")
  carrier               String?
  carrierTrackingUrl    String?   @map("carrier_tracking_url")
  estimatedDeliveryAt   DateTime? @map("estimated_delivery_at") @db.Timestamptz(6)
  currentStatus         String?   @map("current_status")
  shippingNotes         String?   @map("shipping_notes")
  packingSlipStorageKey String?   @map("packing_slip_storage_key")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@map("shipment_tracking")
}

model FulfillmentLine {
  fulfillmentId BigInt @map("fulfillment_id")
  orderLineId   BigInt @map("order_line_id")
  qty           Int

  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderLine   OrderLine   @relation(fields: [orderLineId], references: [id])

  @@id([fulfillmentId, orderLineId])
  @@map("fulfillment_line")
}

/// RMA header (plan/08 §2/§4).
model OrderReturn {
  id        BigInt       @id @default(autoincrement())
  publicId  String       @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  orderId   BigInt       @map("order_id")
  reason    String
  status    ReturnStatus @default(REQUESTED)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines OrderReturnLine[]

  @@index([orderId])
  @@map("order_return")
}

model OrderReturnLine {
  returnId    BigInt  @map("return_id")
  orderLineId BigInt  @map("order_line_id")
  qty         Int
  restock     Boolean @default(true)

  orderReturn OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLine   OrderLine   @relation(fields: [orderLineId], references: [id])

  @@id([returnId, orderLineId])
  @@map("order_return_line")
}

/// Append-only order activity timeline (plan/15 Phase 0b) — deliberately separate
/// from `outbox_event`: the outbox is transient delivery infrastructure (polled,
/// marked published, not indexed for per-order reads); this table is a permanent,
/// order-scoped read model for the admin/storefront "Timeline" UI. `eventType` is
/// a free-form String (not an enum), matching `OutboxEvent.eventType`'s own
/// precedent — new event kinds get added across plan/15's later phases without a
/// schema migration each time.
model OrderStatusHistory {
  id        BigInt                @id @default(autoincrement())
  orderId   BigInt                @map("order_id")
  eventType String                @map("event_type") // 'STATUS_CHANGED' | 'PAYMENT_RECEIVED' | 'INVOICE_CREATED' | 'SHIPMENT_CREATED' | 'TRACKING_ADDED' | 'EMAIL_SENT' | 'NOTE_ADDED' | 'CANCELLED' | 'REFUNDED' | 'CLOSED' | ...
  fromValue String?               @map("from_value")
  toValue   String?               @map("to_value")
  message   String? // human-readable timeline line, e.g. "Order confirmed by admin"
  actorType OrderHistoryActorType @map("actor_type")
  actorId   BigInt?               @map("actor_id") // admin_user.id when actorType=ADMIN; NULL for SYSTEM/CUSTOMER
  actorName String?               @map("actor_name") // display-name snapshot — an admin's name may change later, this line shouldn't
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// plan/15 Phase 0b. Append-only (edit = add a new note, matching PaymentTransaction's
/// established append-only-ledger convention in this same file) rather than mutable.
model OrderNote {
  id        BigInt        @id @default(autoincrement())
  orderId   BigInt        @map("order_id")
  type      OrderNoteType
  body      String
  createdBy BigInt?       @map("created_by") // admin_user.id; NULL if ever customer-authored in a later phase
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type])
  @@map("order_note")
}

/// A formatted invoice document (plan/15 Phase 1). Money columns are a snapshot
/// taken at creation time — like OrderLine, an invoice must never change value
/// because the order was later refunded/adjusted; refunds are reflected via
/// PaymentTransaction/FinancialStatus, not by mutating a past invoice.
/// `invoiceNumber` is a per-website atomic sequence (invoice_number_counter +
/// next_invoice_number(), identical mechanics to order_number). Multiple
/// invoices per order are supported (partial invoicing, same shape as
/// Fulfillment supporting partial shipment).
model OrderInvoice {
  id            BigInt        @id @default(autoincrement())
  publicId      String        @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  orderId       BigInt        @map("order_id")
  invoiceNumber BigInt        @map("invoice_number")
  status        InvoiceStatus @default(ISSUED)
  subtotal      Decimal       @db.Decimal(18, 4)
  discountTotal Decimal       @default(0) @map("discount_total") @db.Decimal(18, 4)
  taxTotal      Decimal       @map("tax_total") @db.Decimal(18, 4)
  grandTotal    Decimal       @map("grand_total") @db.Decimal(18, 4)
  pdfStorageKey String?       @map("pdf_storage_key") // S3/MinIO object key of the rendered PDF (shared/infrastructure/storage/s3-client.ts)
  createdBy     BigInt?       @map("created_by") // admin_user.id; NULL if ever system-issued in a later phase
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines OrderInvoiceLine[]

  @@unique([orderId, invoiceNumber])
  @@index([orderId])
  @@map("order_invoice")
}

/// The invoiced subset of order_line — supports partial invoicing exactly like
/// FulfillmentLine supports partial shipment. Money columns are snapshotted from
/// OrderLine at invoice-creation time (a later refund must not retroactively
/// change what an already-issued invoice says).
model OrderInvoiceLine {
  invoiceId   BigInt  @map("invoice_id")
  orderLineId BigInt  @map("order_line_id")
  qty         Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 4)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(18, 4)
  rowTotal    Decimal @map("row_total") @db.Decimal(18, 4)

  invoice   OrderInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderLine OrderLine    @relation(fields: [orderLineId], references: [id])

  @@id([invoiceId, orderLineId])
  @@map("order_invoice_line")
}

/// Append-only log of every manually-triggered order email (plan/15 Phase 3).
/// `sentBy` NULL means system-triggered — declared for forward-compat with a
/// future auto-send-on-event fast-follow (plan/15 §7); every row this pass
/// writes has a real admin, since only the manual Send Email action exists.
model OrderEmailLog {
  id          BigInt         @id @default(autoincrement())
  orderId     BigInt         @map("order_id")
  emailType   OrderEmailType @map("email_type")
  toEmail     String         @map("to_email")
  subject     String
  status      EmailLogStatus
  providerRef String?        @map("provider_ref")
  sentBy      BigInt?        @map("sent_by") // admin_user.id; NULL = system-triggered
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_email_log")
}
